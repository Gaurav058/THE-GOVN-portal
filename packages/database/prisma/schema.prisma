// Prisma Schema for India Government Jobs Intelligence Platform (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum JobLifecycleStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  PUBLISHED
  APPLICATION_OPEN
  CLOSING_SOON
  APPLICATION_CLOSED
  CORRECTION_OPEN
  ADMIT_CARD_AVAILABLE
  EXAM_SCHEDULED
  EXAM_COMPLETED
  ANSWER_KEY_AVAILABLE
  RESULT_DECLARED
  FINAL_RESULT
  CANCELLED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  AUTO_EXTRACTED
  PENDING_REVIEW
  NEEDS_REVIEW
  VERIFIED
  REJECTED
  CONFLICT_DETECTED
}

enum SourceTrustLevel {
  LEVEL_1_PRIMARY_OFFICIAL
  LEVEL_2_GOVERNMENT_AGGREGATOR
  LEVEL_3_SECONDARY
  LEVEL_4_DISCOVERY_ONLY
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VERIFIER
  SEO_MANAGER
  CONTENT_MANAGER
  SUPPORT
  DATA_OPERATOR
}

enum DocumentType {
  ADVERTISEMENT
  NOTIFICATION
  CORRIGENDUM
  ADDENDUM
  SYLLABUS
  ADMIT_CARD_NOTICE
  RESULT_NOTICE
  ANSWER_KEY
  OTHER
}

enum ChangeType {
  DEADLINE_CHANGED
  VACANCY_CHANGED
  FEE_CHANGED
  AGE_LIMIT_CHANGED
  EXAM_DATE_RESCHEDULED
  ELIGIBILITY_UPDATED
  CORRIGENDUM_ISSUED
  APPLICATION_LINK_UPDATED
  RECRUITMENT_CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum JobTypeEnum {
  PERMANENT
  CONTRACT
  DEPUTATION
  APPRENTICESHIP
}

// -----------------------------------------------------------------------------
// 1. IDENTITY, ACCESS & AUDIT
// -----------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(DATA_OPERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  verifiedJobs Job[]      @relation("VerifiedJobs")
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AdminRolePermission {
  id         String   @id @default(uuid())
  role       AdminRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@map("admin_role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  oldState   Json?
  newState   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phoneNumber  String?   @unique
  passwordHash String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile       UserProfile?
  preferences   UserPreference[]
  subscriptions Subscription[]
  notifications Notification[]

  @@map("users")
}

model UserProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String?
  dateOfBirth     DateTime?
  gender          String?
  category        String?   // UR, OBC, SC, ST, EWS
  highestDegree   String?
  stateId         String?
  state           State?    @relation(fields: [stateId], references: [id])
  isPwD           Boolean   @default(false)
  isExServiceman  Boolean   @default(false)

  @@map("user_profiles")
}

model UserPreference {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferenceKey  String
  preferenceVal  String
  createdAt      DateTime  @default(now())

  @@unique([userId, preferenceKey])
  @@map("user_preferences")
}

// -----------------------------------------------------------------------------
// 2. TAXONOMY & GEOGRAPHY
// -----------------------------------------------------------------------------

model State {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  code      String     @unique // e.g. "DL", "RJ", "UP", "MH"
  districts District[]
  jobs      Job[]
  profiles  UserProfile[]

  @@map("states")
}

model District {
  id      String @id @default(uuid())
  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name    String
  slug    String

  jobs Job[]

  @@unique([stateId, slug])
  @@map("districts")
}

model Organization {
  id                 String           @id @default(uuid())
  name               String           @unique
  slug               String           @unique
  code               String?          @unique
  type               String           // Central, State, PSU, Bank, Defence
  officialWebsiteUrl String
  logoUrl            String?
  trustLevel         SourceTrustLevel @default(LEVEL_1_PRIMARY_OFFICIAL)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  departments       Department[]
  recruitmentBoards RecruitmentBoard[]
  jobs              Job[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?

  jobs Job[]

  @@unique([organizationId, slug])
  @@map("departments")
}

model RecruitmentBoard {
  id             String           @id @default(uuid())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  name           String           @unique // e.g. UPSC, SSC, RRB, IBPS
  slug           String           @unique
  code           String?          @unique
  portalUrl      String
  trustLevel     SourceTrustLevel @default(LEVEL_1_PRIMARY_OFFICIAL)

  jobs Job[]

  @@map("recruitment_boards")
}

model Qualification {
  id          String   @id @default(uuid())
  name        String   @unique // 10th, 12th, ITI, Diploma, Graduate, B.Tech, MBBS, etc.
  slug        String   @unique
  tierLevel   Int      @default(1) // Level hierarchy (1=10th, 2=12th, 3=Graduate, 4=PG)
  description String?

  jobQualifications JobQualification[]

  @@map("qualifications")
}

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique // Police, Railway, SSC, Banking, Defence, Teaching, PSU, etc.
  slug        String   @unique
  description String?
  iconSvg     String?

  jobs Job[]

  @@map("job_categories")
}

model JobType {
  id          String      @id @default(uuid())
  code        JobTypeEnum @unique // PERMANENT, CONTRACT, DEPUTATION, APPRENTICESHIP
  name        String
  description String?

  @@map("job_types")
}

// -----------------------------------------------------------------------------
// 3. CORE JOB & ELIGIBILITY ENTITIES
// -----------------------------------------------------------------------------

model Job {
  id                      String             @id @default(uuid())
  slug                    String             @unique
  title                   String
  shortTitle              String
  referenceNumber         String?            // e.g. "Advt No. 05/2026-ENGG"
  
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id])
  departmentId            String?
  department              Department?        @relation(fields: [departmentId], references: [id])
  recruitmentBoardId      String?
  recruitmentBoard        RecruitmentBoard?  @relation(fields: [recruitmentBoardId], references: [id])

  description             String             @db.Text
  shortDescription        String?            @db.Text
  totalVacancies          Int

  qualificationMin        String?
  qualificationMax        String?

  minimumAge              Int
  maximumAge              Int
  ageCutoffDate           DateTime?
  experienceRequired      String?

  jobType                 JobTypeEnum        @default(PERMANENT)
  employmentType          EmploymentType     @default(FULL_TIME)

  stateId                 String?
  state                   State?             @relation(fields: [stateId], references: [id])
  districtId              String?
  district                District?          @relation(fields: [districtId], references: [id])
  locationSummary         String             // e.g. "All India", "Rajasthan", "New Delhi"
  
  categoryId              String
  category                JobCategory        @relation(fields: [categoryId], references: [id])

  salaryMin               Decimal?           @db.Decimal(12, 2)
  salaryMax               Decimal?           @db.Decimal(12, 2)
  payScale                String?            // e.g. "Pay Level 10 (Rs. 56,100 - 1,77,500)"
  salaryDescription       String?

  feeGeneral              Decimal?           @db.Decimal(8, 2)
  feeObc                  Decimal?           @db.Decimal(8, 2)
  feeSc                   Decimal?           @db.Decimal(8, 2)
  feeSt                   Decimal?           @db.Decimal(8, 2)
  feeFemale               Decimal?           @db.Decimal(8, 2)
  feeOther                Decimal?           @db.Decimal(8, 2)
  feePaymentMethod        String?

  applicationStartDate    DateTime
  applicationEndDate      DateTime
  correctionStartDate     DateTime?
  correctionEndDate       DateTime?

  admitCardDate           DateTime?
  examStartDate           DateTime?
  examEndDate             DateTime?
  answerKeyDate           DateTime?
  resultDate              DateTime?

  officialNotificationUrl String
  officialApplyUrl        String?

  status                  JobLifecycleStatus @default(DRAFT)
  verificationStatus      VerificationStatus @default(UNVERIFIED)
  confidenceLevel         Float              @default(1.0)
  
  verifiedById            String?
  verifiedBy              AdminUser?         @relation("VerifiedJobs", fields: [verifiedById], references: [id])

  sourceId                String
  source                  JobSource          @relation(fields: [sourceId], references: [id])

  publishedAt             DateTime?
  lastUpdatedAt           DateTime           @default(now())
  lastVerifiedAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Structured Child Relations
  qualifications          JobQualification[]
  ageRules                JobAgeRule[]
  categoryRules           JobCategoryRule[]
  locationRules           JobLocationRule[]
  selectionProcess        JobSelectionProcess[]
  posts                   JobPost[]
  documents               JobDocument[]
  sourceDocuments         SourceDocument[]
  statusHistory           JobStatusHistory[]
  changeHistory           JobChangeHistory[]
  exams                   Exam[]

  @@index([status, applicationEndDate])
  @@index([organizationId, status])
  @@index([categoryId, status])
  @@index([stateId, status])
  @@index([publishedAt])
  @@map("jobs")
}

model JobPost {
  id             String        @id @default(uuid())
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  postName       String
  vacancies      Int
  payLevel       String?
  qualifications String?

  positions      JobPosition[]

  @@map("job_posts")
}

model JobPosition {
  id          String   @id @default(uuid())
  jobPostId   String
  jobPost     JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  region      String?
  vacancies   Int

  @@map("job_positions")
}

model JobQualification {
  id              String        @id @default(uuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  qualificationId String
  qualification   Qualification @relation(fields: [qualificationId], references: [id])
  isMandatory     Boolean       @default(true)
  specialization  String?
  minPercentage   Decimal?      @db.Decimal(5, 2)

  @@unique([jobId, qualificationId])
  @@map("job_qualifications")
}

model JobAgeRule {
  id               String   @id @default(uuid())
  jobId            String
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category         String   // SC, ST, OBC, PwD, Ex-Servicemen, Women
  relaxationYears  Int
  remarks          String?

  @@map("job_age_rules")
}

model JobCategoryRule {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category  String   // UR, OBC, SC, ST, EWS
  vacancies Int

  @@map("job_category_rules")
}

model JobLocationRule {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  isAllIndia    Boolean  @default(true)
  stateName     String?
  districtName  String?
  domicileCheck Boolean  @default(false)

  @@map("job_location_rules")
}

model JobDate {
  id          String    @id @default(uuid())
  jobId       String
  dateType    String    // ApplicationStart, ApplicationEnd, CorrectionStart, ExamDate, ResultDate
  dateValue   DateTime
  isTentative Boolean   @default(false)
  remarks     String?

  @@map("job_dates")
}

model JobFee {
  id            String   @id @default(uuid())
  jobId         String
  category      String   // General, OBC, SC, ST, Female
  amount        Decimal  @db.Decimal(8, 2)
  paymentMethod String?

  @@map("job_fees")
}

model JobSalary {
  id           String   @id @default(uuid())
  jobId        String
  minAmount    Decimal  @db.Decimal(12, 2)
  maxAmount    Decimal  @db.Decimal(12, 2)
  payMatrix    String?  // 7th CPC Level 10
  allowances   String?

  @@map("job_salary")
}

model JobSelectionProcess {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageOrder  Int
  stageName   String   // CBT, Written, PET, Interview, DV
  description String?

  @@map("job_selection_process")
}

model JobDocument {
  id            String       @id @default(uuid())
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  documentTitle String
  documentUrl   String
  fileHash      String?
  publishedDate DateTime?
  createdAt     DateTime     @default(now())

  @@map("job_documents")
}

// -----------------------------------------------------------------------------
// 4. SOURCE INGESTION & DOCUMENT STORAGE
// -----------------------------------------------------------------------------

model JobSource {
  id            String           @id @default(uuid())
  name          String           @unique // Employment News, UPSC, SSC, etc.
  slug          String           @unique
  baseUrl       String
  trustLevel    SourceTrustLevel @default(LEVEL_1_PRIMARY_OFFICIAL)
  isActive      Boolean          @default(true)
  fetchSchedule String?          // Cron format
  lastFetchedAt DateTime?
  lastStatus    String?          // SUCCESS, FAILED
  errorLog      String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  jobs          Job[]
  snapshots     SourceSnapshot[]

  @@map("job_sources")
}

model SourceSnapshot {
  id           String    @id @default(uuid())
  sourceId     String
  source       JobSource @relation(fields: [sourceId], references: [id])
  url          String
  httpStatus   Int
  payloadHash  String
  storagePath  String?   // Local disk path or S3 key
  rawPayload   String?   @db.Text
  fetchedAt    DateTime  @default(now())

  @@index([sourceId, fetchedAt])
  @@map("source_snapshots")
}

model SourceDocument {
  id              String       @id @default(uuid())
  jobId           String
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceUrl       String
  documentUrl     String
  documentType    DocumentType @default(NOTIFICATION)
  documentTitle   String
  publishedDate   DateTime?
  retrievedAt     DateTime     @default(now())
  fileHash        String?      // SHA-256 hash
  storagePath     String?
  mimeType        String?      // application/pdf
  documentVersion Int          @default(1)
  isCurrent       Boolean      @default(true)

  @@index([jobId, isCurrent])
  @@map("source_documents")
}

model JobStatusHistory {
  id        String             @id @default(uuid())
  jobId     String
  job       Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus JobLifecycleStatus
  toStatus   JobLifecycleStatus
  reason    String?
  changedAt DateTime           @default(now())

  @@map("job_status_history")
}

model JobChangeHistory {
  id              String     @id @default(uuid())
  jobId           String
  job             Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fieldName       String
  oldValue        String?
  newValue        String?
  changeType      ChangeType
  sourceReference String?
  detectedAt      DateTime   @default(now())
  verifiedAt      DateTime?
  verifiedById    String?

  @@map("job_change_history")
}

// -----------------------------------------------------------------------------
// 5. EXAMINATIONS, RESULTS & ADMIT CARDS
// -----------------------------------------------------------------------------

model Exam {
  id               String       @id @default(uuid())
  jobId            String
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name             String
  slug             String       @unique
  conductingBody   String
  officialPortal   String
  status           String       // Upcoming, Conducted, Cancelled
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  examDates        ExamDate[]
  admitCards       AdmitCard[]
  answerKeys       AnswerKey[]
  results          Result[]

  @@map("exams")
}

model ExamDate {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  stageName String
  examDate  DateTime
  shift     String?

  @@map("exam_dates")
}

model AdmitCard {
  id          String    @id @default(uuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  title       String
  releaseDate DateTime
  downloadUrl String
  instructions String?  @db.Text

  @@map("admit_cards")
}

model AnswerKey {
  id           String    @id @default(uuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  title        String
  keyType      String    // Provisional, Final
  releaseDate  DateTime
  downloadUrl  String
  objectionEnd DateTime?

  @@map("answer_keys")
}

model Result {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title       String
  resultType  String   // Tier 1, Mains, Final Merit List
  declaredAt  DateTime
  resultUrl   String
  cutOffMarks Json?

  @@map("results")
}

// -----------------------------------------------------------------------------
// 6. EDITORIAL, ARTICLES & AUTHORS
// -----------------------------------------------------------------------------

model Author {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  bio       String?
  avatarUrl String?
  articles  Article[]

  @@map("authors")
}

model Article {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?
  authorId    String
  author      Author    @relation(fields: [authorId], references: [id])
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

// -----------------------------------------------------------------------------
// 7. INSTITUTES, COURSES & LEADS (Marketplace readiness)
// -----------------------------------------------------------------------------

model Institute {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  city        String
  state       String
  websiteUrl  String?
  rating      Decimal? @db.Decimal(3, 2)
  isVerified  Boolean  @default(false)
  courses     Course[]

  @@map("institutes")
}

model Course {
  id          String    @id @default(uuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  title       String
  examTarget  String    // UPSC, SSC, Banking
  duration    String
  fees        Decimal?  @db.Decimal(10, 2)
  leads       Lead[]

  @@map("courses")
}

model Lead {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  candidateName String
  candidatePhone String
  candidateEmail String?
  createdAt   DateTime @default(now())

  @@map("leads")
}

// -----------------------------------------------------------------------------
// 8. NOTIFICATIONS & SUBSCRIPTIONS
// -----------------------------------------------------------------------------

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  linkUrl     String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  events      NotificationEvent[]

  @@map("notifications")
}

model NotificationEvent {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String       // SMS, EMAIL, PUSH, WHATSAPP
  status         String       // SENT, DELIVERED, FAILED
  sentAt         DateTime     @default(now())

  @@map("notification_events")
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode  String    // FREE_ALERTS, PRO_TESTS, MENTORSHIP
  status    String    // ACTIVE, EXPIRED, CANCELLED
  startDate DateTime
  endDate   DateTime
  payments  Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  gatewayRef     String?
  status         String       // SUCCESS, PENDING, FAILED
  paidAt         DateTime     @default(now())

  @@map("payments")
}

// -----------------------------------------------------------------------------
// 9. ANALYTICS
// -----------------------------------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String   // JOB_VIEW, APPLY_CLICK, NOTIFICATION_DOWNLOAD, SEARCH
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([eventType, occurredAt])
  @@map("analytics_events")
}
