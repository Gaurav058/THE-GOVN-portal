# ==============================================================================
# India Government Jobs Intelligence Platform - Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/govn_portal?schema=public

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379

# JWT & Authentication Secrets
JWT_SECRET=replace_with_secure_64_char_random_hex_key_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Public URLs & APIs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1

# Admin Portal URL
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Document Object Storage (S3 / MinIO / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_access_key
STORAGE_SECRET_KEY=minio_secret_key
STORAGE_BUCKET=govn-documents
STORAGE_REGION=ap-south-1

# AI Structured Extraction Provider (Optional - strictly verified)
AI_PROVIDER=gemini
AI_PROVIDER_KEY=placeholder_api_key

# Cloudflare / WAF Readiness
CLOUDFLARE_ZONE_ID=placeholder_zone_id
CLOUDFLARE_API_TOKEN=placeholder_token

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=placeholder_fcm_project_id
FCM_CLIENT_EMAIL=placeholder_email
FCM_PRIVATE_KEY=placeholder_key

# Email Configuration (Alerts & Notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_user
SMTP_PASS=placeholder_smtp_pass
FROM_EMAIL=notifications@govnportal.in
